{
  "permissions": {
    "allow": [
      "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File *)",
      "PowerShell(pwsh -NoProfile -ExecutionPolicy Bypass -File *)"
    ],
    "deny": [
      "PowerShell(Format-Volume*)",
      "PowerShell(Clear-Disk*)",
      "PowerShell(Initialize-Disk*)",
      "PowerShell(Remove-Partition*)",
      "PowerShell(diskpart*)",
      "PowerShell(format *)",
      "PowerShell(bcdedit*)",
      "PowerShell(Stop-Computer*)",
      "PowerShell(Restart-Computer*)",
      "PowerShell(shutdown*)",
      "PowerShell(Set-ExecutionPolicy*)",
      "PowerShell(reg add*)",
      "PowerShell(reg delete*)",
      "PowerShell(Remove-ItemProperty*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(shutdown*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D*)",
      "Edit(//c/Windows/**)",
      "Edit(//c/Program Files/**)",
      "Edit(//c/Program Files (x86)/**)"
    ],
    "ask": [
      "PowerShell(Remove-Item*)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "PowerShell(ri *)",
      "PowerShell(icacls*)",
      "PowerShell(takeown*)",
      "PowerShell(Set-Acl*)",
      "PowerShell(Stop-Process*)",
      "PowerShell(taskkill*)",
      "PowerShell(Stop-Service*)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "& (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\ps1-post-edit.ps1'); exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": ".ps1 の BOM と 5.1 の文法を確認"
          }
        ]
      }
    ]
  }
}
